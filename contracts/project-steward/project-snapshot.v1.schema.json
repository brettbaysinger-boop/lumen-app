{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raialume.local/contracts/project-steward/project-snapshot.v1.schema.json",
  "title": "Project Steward v1 read-only project snapshot",
  "description": "Historical and Git-sourced project status. Never infer runtime deployment from PR or tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "projects"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git_repo",
            "git_pr",
            "git_issue",
            "owner_approved_memory",
            "host_receipt",
            "owner_report",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{7,40}$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "priority",
        "state",
        "deployment",
        "evidence_level",
        "repositories",
        "sources",
        "blocked_by",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3",
            "on_hold",
            "unranked"
          ]
        },
        "state": {
          "enum": [
            "planned",
            "coded",
            "tested",
            "owner_accepted",
            "blocked",
            "on_hold",
            "unknown"
          ]
        },
        "deployment": {
          "enum": [
            "verified_current",
            "historically_verified",
            "reported",
            "not_deployed",
            "unknown"
          ]
        },
        "evidence_level": {
          "enum": [
            "host_verified",
            "git_verified",
            "owner_report",
            "historical",
            "unverified"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
