{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raialume.local/contracts/project-steward/project-snapshot.v1.1.schema.json",
  "title": "PROPOSED Project Steward v1.1 read-only project snapshot (not approved)",
  "description": "Proposal from PS-01 (PR #32). v1.0 plus: optional top-level stale_after_seconds, optional per-project insights. A v1.0 document differs only by its version string. Never infer runtime deployment from PR, CI or tests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated_at",
    "projects"
  ],
  "properties": {
    "version": {
      "const": "1.1"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "stale_after_seconds": {
      "type": "integer",
      "minimum": 3600,
      "maximum": 2592000,
      "description": "The backend's staleness window. The UI marks anything older as STALE. Omitted = UI default (72h)."
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref",
        "observed_at"
      ],
      "properties": {
        "kind": {
          "enum": [
            "git_repo",
            "git_pr",
            "git_issue",
            "owner_approved_memory",
            "host_receipt",
            "owner_report",
            "other"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{7,40}$"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "priority",
        "state",
        "deployment",
        "evidence_level",
        "repositories",
        "sources",
        "blocked_by",
        "observed_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]{2,64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2",
            "p3",
            "on_hold",
            "unranked"
          ]
        },
        "state": {
          "enum": [
            "planned",
            "coded",
            "tested",
            "owner_accepted",
            "blocked",
            "on_hold",
            "unknown"
          ]
        },
        "deployment": {
          "enum": [
            "verified_current",
            "historically_verified",
            "reported",
            "not_deployed",
            "unknown"
          ]
        },
        "evidence_level": {
          "enum": [
            "host_verified",
            "git_verified",
            "owner_report",
            "historical",
            "unverified"
          ]
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "repositories": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 240
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "insights": {
          "$ref": "#/$defs/insights"
        }
      }
    },
    "insights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "open_prs",
        "last_commit",
        "last_deploy",
        "ci",
        "next",
        "activity",
        "links"
      ],
      "properties": {
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "open_prs": {
          "description": "null = not collected. items [] = checked, none open.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "observed_at",
                "items"
              ],
              "properties": {
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "ref",
                      "title",
                      "review",
                      "opened_at",
                      "updated_at",
                      "head_sha"
                    ],
                    "properties": {
                      "ref": {
                        "type": "string",
                        "maxLength": 512,
                        "anyOf": [
                          {
                            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$"
                          },
                          {
                            "pattern": "^https://[^\\s]+$"
                          }
                        ]
                      },
                      "title": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      },
                      "review": {
                        "enum": [
                          "draft",
                          "review_required",
                          "changes_requested",
                          "approved"
                        ]
                      },
                      "opened_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "updated_at": {
                        "type": "string",
                        "format": "date-time"
                      },
                      "head_sha": {
                        "type": [
                          "string",
                          "null"
                        ],
                        "pattern": "^[a-f0-9]{7,40}$"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        "last_commit": {
          "description": "Newest commit on the default branch. null = not collected.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "ref",
                "commit_sha",
                "branch",
                "observed_at"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "commit_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{7,40}$"
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "last_deploy": {
          "description": "Newest deployment WITH evidence (host receipt). null = none recorded; never infer from Git.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "at",
                "ref",
                "commit_sha",
                "target",
                "observed_at"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "commit_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{7,40}$"
                },
                "target": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "ci": {
          "description": "Default-branch CI as its own evidence source. null = not collected. state 'none' = checked, no runs exist.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "state",
                "branch",
                "run_ref",
                "commit_sha",
                "observed_at"
              ],
              "properties": {
                "state": {
                  "enum": [
                    "passing",
                    "failing",
                    "pending",
                    "none",
                    "unknown"
                  ]
                },
                "branch": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "run_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1,
                  "maxLength": 512
                },
                "commit_sha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[a-f0-9]{7,40}$"
                },
                "observed_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          ]
        },
        "next": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text",
              "ref"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "owner_decision",
                  "milestone"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "activity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "kind",
              "text",
              "ref"
            ],
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "kind": {
                "enum": [
                  "commit",
                  "pr",
                  "issue",
                  "ci",
                  "deploy",
                  "decision",
                  "note"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "ref": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "label",
              "url"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "repo",
                  "live",
                  "issues",
                  "docs"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "url": {
                "type": "string",
                "pattern": "^https://[^\\s]+$",
                "maxLength": 512
              }
            }
          }
        }
      }
    }
  }
}
