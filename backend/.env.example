LUMEN_ENV=development
LUMEN_LOG_LEVEL=INFO
LUMEN_API_HOST=0.0.0.0
LUMEN_API_PORT=8000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

OLLAMA_URL=http://host.docker.internal:11434
CONVERSATION_MODEL=llama3.1:8b
REFLECTION_MODEL=llama3.1:8b
MEMORY_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# Helios speech server (no /v1 suffix).
SPEECH_URL=http://100.121.251.39:8000
TRANSCRIPTION_MODEL=Systran/faster-distil-whisper-small.en
SPEECH_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
SPEECH_VOICE=af_heart

LUMEN_CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Clear direct facts save automatically when enabled for the companion.
# Uncertain, sensitive and conflicting proposals require confirmation.
MEMORY_OBSERVATIONS_ENABLED=true
# Blank follows the selected companion model, avoiding chat/extraction model swaps.
MEMORY_OBSERVATION_MODEL=

# Explicit context allocation and model residency for Lumen requests.
CHAT_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=15m

# Image generation is routed through Lumen rather than directly from the app.
# COMFYUI_URL may point at any node exposing the image capability.
IMAGE_PROVIDER=comfyui
COMFYUI_URL=
# Path to ComfyUI API-format workflow JSON containing {{LUMEN_PROMPT}}.
COMFYUI_WORKFLOW=
IMAGE_GENERATION_TIMEOUT=300
